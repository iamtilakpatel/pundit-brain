menu "Target board"

choice BOARD_TARGET
    prompt "Board"
    depends on IDF_TARGET_ESP32S3
    default BOARD_FREENOVE_FNK0104B

config BOARD_FREENOVE_FNK0104B
    bool "Freenove FNK0104B"

config BOARD_WAVESHARE_AMOLED_2_16
    bool "Waveshare ESP32-S3-Touch-AMOLED-2.16"
    help
        Minimal startup diagnostics only. All board peripherals and the
        application pipeline remain uninitialized until hardware bring-up.

endchoice

endmenu
